{
  "cli": {
    "version": ">= 7.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_DOCTOR_ENABLE": "0"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_DOCTOR_ENABLE": "0",
        "EXPO_PUBLIC_API_URL": "https://YOUR_RENDER_URL.onrender.com/api/v1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://YOUR_RENDER_URL.onrender.com/api/v1"
      }
    }
  }
}
