PROJECT_NAME="Intelligent Cognitive Alarm Platform"
API_V1_STR="/api/v1"

# Database Connection (Supports either DATABASE_URL or individual POSTGRES_* vars)
# DATABASE_URL=postgresql://cognitive_user:cognitive_password@localhost:5432/cognitive_alarm_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cognitive_user
POSTGRES_PASSWORD=cognitive_password
POSTGRES_DB=cognitive_alarm_db

MONGODB_URL=mongodb://localhost:27017/cognitive_challenges

REDIS_URL=redis://localhost:6379/0

# JWT Auth Variables
SECRET_KEY="your-super-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (comma-separated origins e.g. https://your-app.vercel.app or *)
CORS_ORIGINS="*"

# Firebase & AI
FIREBASE_CREDENTIALS_PATH="firebase-credentials.json"
GEMINI_API_KEY="your-gemini-api-key"